[Unit]
Description=Piggy Go chat admin
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
WorkingDirectory=/lighten012/projects/Piggy/current
ExecStart=/lighten012/projects/Piggy/current/piggy-admin
EnvironmentFile=/lighten012/projects/Piggy/server.env
Environment=GOMEMLIMIT=64MiB
MemoryAccounting=yes
MemoryHigh=80M
MemoryMax=112M
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
