[Unit]
Description=Piggy shared Pi Agent
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
WorkingDirectory=/lighten012/projects/Piggy/current
EnvironmentFile=/lighten012/projects/Piggy/server.env
UnsetEnvironment=PIGGY_ADMIN_PASSWORD
Environment=HOST=127.0.0.1 PORT=18889 NODE_ENV=production
ExecStart=/lighten012/projects/Piggy/runtime/node --max-old-space-size=96 pi.mjs
Restart=on-failure
RestartSec=3
MemoryAccounting=yes
MemoryHigh=160M
MemoryMax=224M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
