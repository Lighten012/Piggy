[Unit]
Description=Piggy Office document preview

[Service]
DynamicUser=yes
RuntimeDirectory=piggy-preview
RuntimeDirectoryMode=0755
ExecStart=/run/piggy-office-bin serve-preview
BindReadOnlyPaths=/lighten012/projects/Piggy/current/piggy-admin:/run/piggy-office-bin
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
NoNewPrivileges=yes
TemporaryFileSystem=/tmp:size=192M,mode=1777,nosuid,nodev
TemporaryFileSystem=/lighten012:ro /etc:ro /var:ro
BindReadOnlyPaths=/etc/fonts -/etc/libreoffice /etc/alternatives -/etc/ld.so.cache -/etc/localtime -/var/cache/fontconfig
ProtectProc=invisible
MemoryAccounting=yes
MemoryHigh=320M
MemoryMax=384M
TasksMax=64
LimitFSIZE=96M
UMask=0077
Restart=on-failure

[Install]
WantedBy=multi-user.target
