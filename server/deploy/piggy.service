[Unit]
Description=Piggy chat admin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/piggy/server
EnvironmentFile=/etc/piggy/server.env
Environment=HOST=0.0.0.0 PORT=8888 NODE_ENV=production
LoadCredential=tls.crt:/etc/piggy/fullchain.pem
LoadCredential=tls.key:/etc/piggy/privkey.pem
Environment=PIGGY_TLS_CERT=%d/tls.crt PIGGY_TLS_KEY=%d/tls.key
ExecStart=/usr/bin/env node --max-old-space-size=96 server.ts
Restart=on-failure
RestartSec=5
MemoryAccounting=yes
MemoryHigh=160M
MemoryMax=224M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
