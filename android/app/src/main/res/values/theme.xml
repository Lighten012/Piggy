<resources>
    <style name="PiggyTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#70528D</item>
        <item name="android:windowBackground">#FAF9FC</item>
        <item name="android:statusBarColor">#FAF9FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FAF9FC</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="DrawerMotion">
        <item name="android:windowEnterAnimation">@anim/drawer_enter</item>
        <item name="android:windowExitAnimation">@anim/drawer_exit</item>
    </style>
</resources>
